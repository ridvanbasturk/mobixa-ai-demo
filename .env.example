# Amazon Bedrock Mantle (OpenAI uyumlu) endpoint ayarları
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin.
# .env dosyasını asla git'e commit etmeyin.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1

AWS_REGION=us-east-1

# --- Seçici Gemma 4 göçü (bkz. services/model_registry.py) ------------------
#
# B1/B6/C1/A1(storyboard): KARIŞIK çift — Plan A = Qwen3 235B (korunur),
# Plan B = Gemma 4 31B (yeni). Her iki plan da normal karşılaştırma kartı
# olarak gösterilir; hiçbir sağlayıcının otomatik olarak daha iyi olduğu
# ima edilmez. Qwen3 32B yalnızca teknik yedektir (fallback) — normal
# karşılaştırmada aktif bir plan DEĞİLDİR, yalnızca "Teknik detaylar"
# panelinde gösterilir.
#
# A2 (Destek/Onboarding Chatbot): TEK istisna — aktif yanıt üretim modelleri
# YALNIZCA Gemma'dır. Kimi K2.5 ve DeepSeek V3.2 artık aktif değildir
# (legacy_disabled — geçmiş evaluations.csv kayıtları SİLİNMEDİ, yalnızca
# yeni çağrılarda seçilmiyorlar). Qwen3 32B yalnızca acil durum teknik
# yedeğidir; A2_MODEL_B boş bırakılırsa arayüz tek aktif Gemma modeliyle
# sorunsuz çalışır (ikinci bir Plan B kartı gösterilmez).

B1_MODEL_A=qwen.qwen3-235b-a22b-2507
B1_MODEL_B=google.gemma-4-31b
B1_FALLBACK_MODEL=qwen.qwen3-32b

B6_MODEL_A=qwen.qwen3-235b-a22b-2507
B6_MODEL_B=google.gemma-4-31b
B6_FALLBACK_MODEL=qwen.qwen3-32b

C1_MODEL_A=qwen.qwen3-235b-a22b-2507
C1_MODEL_B=google.gemma-4-31b
C1_FALLBACK_MODEL=qwen.qwen3-32b

# Eski paylaşımlı değişkenler — geriye dönük uyumluluk için hâlâ okunur
# (yalnızca yukarıdaki B1_MODEL_A/B vb. TANIMLANMAMIŞSA kullanılır).
TEXT_MODEL_A=qwen.qwen3-235b-a22b-2507
TEXT_MODEL_B=google.gemma-4-31b

A2_MODEL_A=google.gemma-4-31b
# İkinci doğrulanmış bir Gemma varyantı yoksa boş bırakın — arayüz tek aktif
# Gemma modeliyle çalışır. google.gemma-4-26b-a4b gerçek çağrıyla doğrulandı.
A2_MODEL_B=google.gemma-4-26b-a4b
A2_FALLBACK_MODEL=qwen.qwen3-32b

# A1 (AI Destekli Kullanım Videosu — storyboard üretimi) kendi model
# çiftini kullanır; B1/B6/C1/A2 yapılandırmasının yerine geçmez.
A1_STORYBOARD_MODEL_A=qwen.qwen3-235b-a22b-2507
A1_STORYBOARD_MODEL_B=google.gemma-4-31b
A1_STORYBOARD_FALLBACK=qwen.qwen3-32b

# Eski paylaşımlı A1 değişkenleri (geriye dönük uyumluluk için hâlâ okunur).
A1_MODEL_A=qwen.qwen3-235b-a22b-2507
A1_MODEL_B=qwen.qwen3-32b

# A1 Sahne Genişletme (Faz 4C): maliyet için varsayılan olarak TEK aktif
# model kullanılır (iki model otomatik çağrılmaz). Qwen3 235B, arayüzden
# seçilebilir bir alternatiftir.
A1_EXPANSION_MODEL=google.gemma-4-31b
A1_EXPANSION_ALT_MODEL=qwen.qwen3-235b-a22b-2507

# A1 AI Görsel Analiz Modu (vision) kendi çok-modlu model çiftini kullanır;
# yukarıdaki A1_STORYBOARD_MODEL_A/B ile karıştırılmamalıdır.
# A1_VISION_MODEL_A için Bedrock kataloğundaki gerçek Qwen3 VL model
# kimliğini girin; tahmini/uydurma bir değer kullanmayın. Gemma 4 31B,
# gerçek görsel girişle doğrulandığı için Plan B olarak kullanılır.
A1_VISION_MODEL_A=<qwen3-vl-model-id>
A1_VISION_MODEL_B=google.gemma-4-31b

# İSTEĞE BAĞLI override — TANIMLAMANIZ GEREKMEZ. google.gemma-4-31b gibi
# modeller, standart OPENAI_BASE_URL (/v1) rotasında değil, yalnızca
# Mantle'ın OpenAI-uyumlu /openai/v1 rotasında çalışır
# (services/model_registry.py::resolve_model_route bunu otomatik olarak
# yönetir ve doğru base_url'i OPENAI_BASE_URL'den güvenli biçimde türetir).
# Bu değişken yalnızca Mantle hesabınızda /openai/v1 rotası farklı bir
# adreste yayınlanıyorsa manuel olarak GEÇERSİZ KILMAK için vardır.
# OPENAI_BASE_URL_GEMMA=https://bedrock-mantle.eu-central-1.api.aws/openai/v1

# Model çağrıları arasında bekleme süresi (saniye). Yeni AWS hesaplarında
# throttling yaşanmaması için kullanılır.
INTER_MODEL_DELAY_SECONDS=1

# Bedrock Mantle çağrıları için açık zaman aşımları (saniye) ve maksimum
# yeniden deneme sayısı. Bir model yanıt vermezse Streamlit sayfasının
# süresiz beklememesi için kullanılır. Sır içermez.
BEDROCK_CONNECT_TIMEOUT_SECONDS=10
BEDROCK_REQUEST_TIMEOUT_SECONDS=45
BEDROCK_MAX_RETRIES=0
